<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiHotel.MainPage"
    BackgroundColor="#F1F5F9"
    Title="Home">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="25">

            <Frame
                BackgroundColor="#1E3A8A"
                CornerRadius="20"
                Padding="25"
                HasShadow="True">

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        Text="APP HOTEL"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Sistema moderno de hospedagem desenvolvido em .NET MAUI"
                        FontSize="18"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Frame>

            <Image
                Source="dotnet_bot.png"
                HeightRequest="220"
                HorizontalOptions="Center" />

            <Frame
                BackgroundColor="White"
                CornerRadius="20"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Bem-vindo"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#1E293B" />

                    <Label
                        Text="Aplicativo criado para gerenciamento moderno de hospedagem e reservas."
                        FontSize="18"
                        TextColor="#475569" />

                </VerticalStackLayout>

            </Frame>

            <Button
                Text="Abrir Tela Sobre"
                Clicked="AbrirSobre"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="20"
                CornerRadius="15"
                HeightRequest="60" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
